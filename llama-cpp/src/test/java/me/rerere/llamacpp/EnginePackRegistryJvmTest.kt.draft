package me.rerere.llamacpp

import android.util.Base64
import androidx.test.core.app.ApplicationProvider
import androidx.test.ext.junit.runners.RobolectricTestRunner
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test
import org.junit.runner.RunWith
import java.io.File
import java.security.KeyPair
import java.security.KeyPairGenerator
import java.security.MessageDigest
import java.security.Signature

/**
 * US-006/US-007 CI gate (Robolectric, runs in app-unit-tests — no device needed).
 * Unlike the androidTest twin (device realism, US-008 battery), this suite generates REAL
 * Ed25519 keypairs on the JVM and signs canonical manifest bytes, so signature interop,
 * tamper decline, downgrade refusal, resume plumbing, and rollback all execute for real
 * in CI.
 */
@RunWith(RobolectricTestRunner::class)
class EnginePackRegistryJvmTest {
    private val root: File get() = File(ApplicationProvider.getApplicationContext<android.content.Context>().filesDir.parentFile, "jvmpacks-" + System.nanoTime())
    private val keys: KeyPair by lazy { KeyPairGenerator.getInstance("Ed25519").generateKeyPair() }
    private val pubB64: String by lazy {
        // JDK encodes Ed25519 public keys as DER SPKI; raw key = trailing 32 bytes.
        val enc = keys.public.encoded
        Base64.encodeToString(enc.copyOfRange(enc.size - 32, enc.size), Base64.NO_WRAP)
    }

    private fun sha(b: ByteArray): String =
        MessageDigest.getInstance("SHA-256").digest(b).joinToString("") { "%02x".format(it) }

    private data class Pack(val dir: File, val manifestText: String)

    private fun syntheticPack(id: String, version: Int, sign: Boolean = true, tamper: String? = null): Pack {
        val dir = File(root, "src-" + id + "-" + version).apply { mkdirs() }
        val lib = ByteArray(4) { 'a'.code.toByte() }
        File(dir, "libllama.so").writeBytes(lib)
        val manifest = "{\n" +
            "  \"id\": \"" + id + "\",\n" +
            "  \"version\": " + version + ",\n" +
            "  \"abi\": \"arm64-v8a\",\n" +
            "  \"backend\": \"hexagon\",\n" +
            "  \"min_app_version_code\": 1,\n" +
            "  \"files\": [\n" +
            "    {\"path\": \"libllama.so\", \"size\": " + lib.size + ", \"sha256\": \"" + sha(lib) + "\"}\n" +
            "  ],\n" +
            "  \"provenance\": \"test\"\n" +
            "}\n"
        val bytes = manifest.toByteArray(Charsets.UTF_8)
        val sig = if (sign) {
            val s = Signature.getInstance("Ed25519")
            s.initSign(keys.private)
            s.update(EnginePackRegistry.canonical(bytes))
            File(dir, "manifest.sig").writeBytes(s.sign())
        } else {
            File(dir, "manifest.sig").writeBytes(ByteArray(64))
        }
        if (tamper == "content") {
            File(dir, "libllama.so").writeBytes(ByteArray(4) { 'b'.code.toByte() })
        }
        if (tamper == "sig") {
            sig[0] = (sig[0].toInt() xor 1).toByte()
            File(dir, "manifest.sig").writeBytes(sig)
        }
        if (tamper == "manifest") {
            File(dir, "manifest.json").writeBytes(bytes.replaceVersion())
            File(dir, "manifest.sig").writeBytes(sig)
        }
        File(dir, "manifest.json").writeBytes(bytes)
        return Pack(dir, manifest)
    }

    private fun ByteArray.replaceVersion(): ByteArray =
        decodeToString().replace("\"version\": ", "\"version\": 9").toByteArray(Charsets.UTF_8)

    private fun packtoolsAvailable(): Boolean = try {
        Class.forName("nazarick.packtools.Pack"); true
    } catch (e: Throwable) { false }

    @Test
    fun canonicalIsOrderInsensitiveAndByteStable() {
        if (!packtoolsAvailable()) return
        val a = """{"b": 1, "a": [1, 2, {"d": true, "c": null}]}"""
        val b = """{"a":[1,2,{"c":null,"d":true}],"b":1}"""
        val ca = EnginePackRegistry.canonical(a.toByteArray())
        val cb = EnginePackRegistry.canonical(b.toByteArray())
        assertEquals(ca.toList(), cb.toList())
        val ref = nazarick.packtools.Pack.canonicalize(
            nazarick.packtools.Pack.parseManifest(a),
        ).toByteArray()
        assertEquals(ref.toList(), ca.toList())
    }

    @Test
    fun acceptsRealSignedPack() {
        val p = syntheticPack("jvmpack", 1)
        val res = EnginePackRegistry.discover(root, pubB64)
        assertTrue("expected Accepted, got " + res::class.simpleName + " " +
            (res as? EnginePackRegistry.Result.Declined)?.decline?.let { it.packDir + ":" + it.reason } ?: "",
            res is EnginePackRegistry.Result.Accepted)
    }

    @Test
    fun declinesTamperedContent() {
        syntheticPack("jvmpack", 1)
        syntheticPack("jvmpack", 2, tamper = "content")
        val res = EnginePackRegistry.discover(root, pubB64)
        assertTrue(res is EnginePackRegistry.Result.Declined)
        assertEquals(EnginePackRegistry.Decline.SHA, res.decline.reason)
    }

    @Test
    fun declinesTamperedSignature() {
        syntheticPack("jvmpack", 3, tamper = "sig")
        val res = EnginePackRegistry.discover(root, pubB64)
        assertTrue(res is EnginePackRegistry.Result.Declined)
        assertEquals(EnginePackRegistry.Decline.SIGNATURE, res.decline.reason)
    }

    @Test
    fun declinesTamperedManifestAgainstGoodSig() {
        syntheticPack("jvmpack", 4, tamper = "manifest")
        val res = EnginePackRegistry.discover(root, pubB64)
        assertTrue(res is EnginePackRegistry.Result.Declined)
        assertTrue(res.decline.reason == EnginePackRegistry.Decline.SIGNATURE ||
            res.decline.reason == EnginePackRegistry.Decline.SHA)
    }

    @Test
    fun unknownKeysAreToleratedByLoaderAndRejectedByCanonicalTool() {
        if (!packtoolsAvailable()) return
        val manifest = """{"id":"x","version":1,"abi":"arm64-v8a","backend":"hexagon","min_app_version_code":1,"files":[],"provenance":"t","future_field":"ok"}"""
        val bytes = manifest.toByteArray()
        val manifestObj = nazarick.packtools.Pack.parseManifest(manifest)
        assertTrue(manifestObj["future_field"] != null)
        var threw = false
        try {
            nazarick.packtools.Pack.verify(File.createTempFile("v", ".json"), File.createTempFile("s", ".sig"), pubB64)
        } catch (e: Throwable) { threw = true }
        assertTrue("strict tool must reject unknown keys (interop contract)", threw)
        assertNotNull(EnginePackRegistry.parseManifest(manifest))
    }

    // ---- US-007 downloader ----

    private class FetchRecorder(val payload: ByteArray) {
        val calls = mutableListOf<Pair<String, Long>>()
        operator fun invoke(url: String, part: File, resumeFrom: Long): Long {
            calls += url to resumeFrom
            val out = ByteArray((resumeFrom + payload.size).toInt())
            part.writeBytes(out)
            return out.size.toLong()
        }
    }

    private fun unpackTo(dir: File): (File, File) -> Unit = { _, dest ->
        File(dest, "libllama.so").writeBytes(ByteArray(4) { 'a'.code.toByte() })
    }

    @Test
    fun downloaderInstallsWithRealSignature() {
        val manifestDir = syntheticPack("dlpack", 7)
        val manifestBytes = manifestDir.manifestText.toByteArray()
        val s = Signature.getInstance("Ed25519")
        s.initSign(keys.private)
        s.update(EnginePackRegistry.canonical(manifestBytes))
        val sigBytes = s.sign()
        val dl = EnginePackDownloader(root, FetchRecorder(ByteArray(10)), unpackTo(root), pubB64)
        val res = dl.installFrom(manifestBytes, sigBytes, "https://example.invalid/p.zip")
        assertTrue("expected Installed, got " + res, res is EnginePackDownloader.Outcome.Installed)
        assertTrue(File(root, "engine-packs/dlpack-7/manifest.json").exists())
    }

    @Test
    fun downloaderRefusesDowngradeAndResumes() {
        val m = syntheticPack("dlpack", 2).manifestText.toByteArray()
        val s = Signature.getInstance("Ed25519")
        s.initSign(keys.private)
        s.update(EnginePackRegistry.canonical(m))
        val sig = s.sign()
        val part = File(root, "engine-packs/.staging/dlpack-2.part")
        part.parentFile!!.mkdirs()
        part.writeBytes(ByteArray(3))
        val rec = FetchRecorder(ByteArray(1))
        val dl = EnginePackDownloader(root, rec, unpackTo(root), pubB64)
        val first = dl.installFrom(m, sig, "https://example.invalid/p.zip")
        assertTrue(first is EnginePackDownloader.Outcome.Installed)
        assertEquals(3L, rec.calls[0].second)
        val again = dl.installFrom(m, sig, "https://example.invalid/p.zip")
        assertTrue(again is EnginePackDownloader.Outcome.RefusedDowngrade)
        val lower = dl.installFrom(syntheticPack("dlpack", 1).manifestText.toByteArray(), sig, "u")
        assertTrue(lower is EnginePackDownloader.Outcome.RefusedDowngrade)
    }

    @Test
    fun downloaderRollsBackOnVerifyFailure() {
        val m = syntheticPack("badpack", 5).manifestText
            .replace(sha(ByteArray(4) { 'a'.code.toByte() }), sha(ByteArray(4) { 'z'.code.toByte() }))
            .toByteArray()
        val s = Signature.getInstance("Ed25519")
        s.initSign(keys.private)
        s.update(EnginePackRegistry.canonical(m))
        val dl = EnginePackDownloader(root, FetchRecorder(ByteArray(10)), unpackTo(root), pubB64)
        val res = dl.installFrom(m, s.sign(), "u")
        assertTrue(res is EnginePackDownloader.Outcome.Failed)
        assertEquals("verify", (res as EnginePackDownloader.Outcome.Failed).stage)
        assertEquals("sha", res.detail)
        assertNull(File(root, "engine-packs/badpack-5/manifest.json").takeIf { it.exists() })
    }
}
