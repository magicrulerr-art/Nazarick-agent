<?xml version="1.0" encoding="utf-8"?>
<resources>

<style name="Theme.Rikkahub" parent="Theme.Material3.DayNight.NoActionBar" />

<!-- v0.6 cold-start splash (owner: "splash i like"): the wave-Ainz sprite on obsidian,
     via androidx.core:core-splashscreen — the system splash on 31+, a compatible window
     overlay below. postSplashScreenTheme hands the window straight back to the normal
     app theme, so there is no color flash between splash and first Compose frame. -->
<style name="Theme.Rikkahub.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">#FF0B0A10</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_ainz</item>
    <item name="windowSplashScreenIconBackgroundColor">#FF14121C</item>
    <item name="postSplashScreenTheme">@style/Theme.Rikkahub</item>
</style>

<style name="Theme.Rikkahub.ToolHost" parent="Theme.Rikkahub">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:backgroundDimEnabled">false</item>
</style>

<!-- Bottom quick-chat panel hosted by the floating ball. Translucent so whatever app the
     user is in stays visible behind the panel, no dim, no window animation (the panel does
     its own slide-in in Compose). -->
<style name="Theme.Rikkahub.QuickChat" parent="Theme.Rikkahub">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:backgroundDimEnabled">false</item>
</style>
</resources>
